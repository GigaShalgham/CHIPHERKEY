<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      CipherKey deliberately requests ZERO Android permissions.

      The companion architecture (spec 003) is entirely permission-free:
      text arrives via ACTION_PROCESS_TEXT / ACTION_SEND or is read from
      the clipboard only after an explicit user action while CipherKey
      is in the foreground (permitted without any runtime permission).
    -->

    <application
        android:name=".CipherKeyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CipherKey">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Companion entries (Option E). Labels are user-visible in the
          system selection toolbar and sharesheet; keep them short.
          noHistory + excludeFromRecents: utility flows, nothing kept in
          recents; an abandoned flow is discarded (passphrase included).
        -->

        <activity
            android:name=".companion.EncryptActivity"
            android:exported="true"
            android:label="@string/process_text_encrypt_label"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CipherKey">
            <intent-filter android:label="@string/process_text_encrypt_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".companion.DecryptActivity"
            android:exported="true"
            android:label="@string/process_text_decrypt_label"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CipherKey">
            <intent-filter android:label="@string/process_text_decrypt_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".companion.ShareDecryptActivity"
            android:exported="true"
            android:label="@string/share_decrypt_label"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CipherKey">
            <intent-filter android:label="@string/share_decrypt_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
